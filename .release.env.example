# Release signing configuration
# Copy this file to .release.env and fill in your values.

# Tauri updater signature. This is required for latest.json updater artifacts,
# but it is not Apple code signing or notarization.
TAURI_SIGNING_PRIVATE_KEY_PATH="$HOME/.tauri/yeek.key"
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=""

# Optional Apple distribution signing. Required to avoid Gatekeeper warnings for
# downloaded macOS apps. The certificate must be installed in your keychain.
# APPLE_SIGNING_IDENTITY="Developer ID Application: Your Name (TEAMID)"

# Optional Apple notarization credentials. Configure either Apple ID credentials:
# APPLE_ID="developer@example.com"
# APPLE_PASSWORD="app-specific-password"
# APPLE_TEAM_ID="TEAMID"

# Or App Store Connect API key credentials:
# APPLE_API_KEY="KEYID"
# APPLE_API_ISSUER="ISSUER_UUID"
# APPLE_API_KEY_PATH="/path/to/AuthKey_KEYID.p8"

# Optional Homebrew tap update after a GitHub Release is created.
# Set UPDATE_HOMEBREW_TAP=0 to skip.
HOMEBREW_TAP_REPO="walnut1024/homebrew-yeek"
UPDATE_HOMEBREW_TAP=1

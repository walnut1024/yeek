#!/usr/bin/env bash
# Pre-commit hook: enforce Rust code standards before commit.
#
# Install: cp scripts/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit
#
# Checks:
#   1. cargo fmt --all --check   (formatting)
#   2. cargo clippy --workspace  (lint)
#
# Skipped if no .rs files are staged.

set -euo pipefail

STAGED_RS=$(git diff --cached --name-only --diff-filter=ACM | grep '\.rs$' || true)
if [ -z "$STAGED_RS" ]; then
    exit 0
fi

echo "==> Checking Rust code standards..."

echo "  [1/2] cargo fmt --all --check..."
if ! cargo fmt --all --check; then
    echo ""
    echo "  ERROR: Code is not formatted. Run: cargo fmt --all"
    exit 1
fi

echo "  [2/2] cargo clippy --workspace -- -D warnings..."
if ! cargo clippy --workspace -- -D warnings 2>&1; then
    echo ""
    echo "  ERROR: Clippy found warnings. Fix them and try again."
    exit 1
fi

echo "  OK: All Rust checks passed."
